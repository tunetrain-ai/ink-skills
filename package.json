{
  "name": "@tunetrain-ai/ink-skills",
  "version": "0.2.0",
  "description": "Hierarchical agent skills catalog for Ink (React for CLIs) — core concepts, components, hooks, and ecosystem, for Claude Code and any Agent Skills-compatible client.",
  "license": "MIT",
  "type": "module",
  "author": "tunetrain.ai",
  "homepage": "https://github.com/tunetrain-ai/ink-skills#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunetrain-ai/ink-skills.git"
  },
  "bugs": {
    "url": "https://github.com/tunetrain-ai/ink-skills/issues"
  },
  "keywords": [
    "ink",
    "agent-skills",
    "claude",
    "claude-code",
    "skills.sh",
    "react",
    "cli",
    "tui"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "skills",
    "skills.sh.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "typecheck": "node scripts/typecheck-snippets.mjs",
    "index": "node scripts/generate-index.mjs",
    "check": "npm run validate && npm run typecheck && npm run smoke && npm test && npm run test:coverage -- --require-results",
    "fetch-sources": "node scripts/fetch-sources.mjs",
    "check-drift": "node scripts/check-upstream-drift.mjs",
    "format": "prettier --write \"skills/**/*.md\" \"*.md\" \"scripts/**/*.mjs\"",
    "version": "npm run index && git add skills.sh.json .claude-plugin README.md docs skills",
    "smoke": "node scripts/smoke-imports.mjs",
    "test": "node tests/run.mjs",
    "test:setup": "npm ci --prefix tests/external",
    "test:coverage": "node tests/coverage.mjs",
    "test:mutate": "node tests/mutate.mjs"
  },
  "devDependencies": {
    "@alcalzone/ink-table": "^1.1.1",
    "@inkjs/ui": "^2.0.0",
    "@pppp606/ink-chart": "^0.2.8",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "cli-highlight": "^2.1.11",
    "cli-spinners": "^3.4.0",
    "ink": "^8.0.0",
    "ink-big-text": "^2.0.0",
    "ink-form": "^2.0.2",
    "ink-gradient": "^4.0.1",
    "ink-link": "^5.0.0",
    "ink-spawn": "^0.1.4",
    "ink-task-list": "^2.0.0",
    "ink-testing-library": "^4.0.0",
    "marked": "^18.1.1",
    "marked-terminal": "^7.3.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "semver": "^7.8.5",
    "skills": "^1.7.2",
    "string-width": "^8.3.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
