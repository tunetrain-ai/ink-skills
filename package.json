{
  "name": "@tunetrain-ai/ink-skills",
  "version": "0.1.0",
  "description": "Hierarchical agent skills catalog for Ink (React for CLIs) — core concepts, components, hooks, and ecosystem, for Claude Code and any Agent Skills-compatible client.",
  "license": "MIT",
  "type": "module",
  "author": "tunetrain.ai",
  "homepage": "https://github.com/tunetrain-ai/ink-skills#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunetrain-ai/ink-skills.git"
  },
  "bugs": {
    "url": "https://github.com/tunetrain-ai/ink-skills/issues"
  },
  "keywords": [
    "ink",
    "agent-skills",
    "claude",
    "claude-code",
    "skills.sh",
    "react",
    "cli",
    "tui"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "skills",
    "skills.sh.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "typecheck": "node scripts/typecheck-snippets.mjs",
    "index": "node scripts/generate-index.mjs",
    "check": "npm run validate && npm run typecheck",
    "fetch-sources": "node scripts/fetch-sources.mjs",
    "check-drift": "node scripts/check-upstream-drift.mjs",
    "format": "prettier --write \"skills/**/*.md\" \"*.md\" \"scripts/**/*.mjs\""
  },
  "devDependencies": {
    "@inkjs/ui": "^2.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.4.2",
    "react": "^19.2.0",
    "typescript": "^7.0.2",
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=20"
  }
}
